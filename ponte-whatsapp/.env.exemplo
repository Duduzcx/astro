# Copie para .env e preencha.

# A mesma chave cadastrada na Vercel como EVOLUTION_API_KEY (16+ caracteres,
# invente uma: openssl rand -hex 24). É o que prova, dos dois lados, quem é quem.
PONTE_CHAVE=

# O site. Só mude se o endereço mudar.
SITE_URL=https://astrosolucoes.vercel.app

# Opcionais.
# INSTANCIA=astro-pessoal      o nome da instância (EVOLUTION_INSTANCIA_PESSOAL na Vercel, se mudar)
# PORTA=3777                   a porta local da ponte
# URL_PUBLICA=https://...      já tem endereço público (servidor com domínio)? Então não abre túnel.
# SEM_TUNEL=1                  não abrir túnel nem registrar no site (só testes locais)
